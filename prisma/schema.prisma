model UsageReservation {
  id                   String                 @id @default(uuid()) @db.Uuid
  quotaPeriodId        String                 @map("quota_period_id") @db.Uuid
  workspaceId          String                 @map("workspace_id") @db.Uuid
  userId               String?                @map("user_id")
  modelPriceId         String?                @map("model_price_id") @db.Uuid
  logicalOperationId   String                 @unique @map("logical_operation_id") @db.Uuid
  status               UsageReservationStatus @default(RESERVED)
  reservedRequests     BigInt                 @default(1) @map("reserved_requests")
  reservedInputTokens  BigInt                 @map("reserved_input_tokens")
  reservedOutputTokens BigInt                 @map("reserved_output_tokens")
  reservedCostMicros   BigInt                 @default(0) @map("reserved_cost_micros")
  actualInputTokens    BigInt?                @map("actual_input_tokens")
  actualOutputTokens   BigInt?                @map("actual_output_tokens")
  actualCostMicros     BigInt?                @map("actual_cost_micros")
