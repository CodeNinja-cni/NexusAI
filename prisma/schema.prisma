  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  execution WorkflowExecution @relation(fields: [executionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([executionId, sequence])
  @@index([workspaceId, executionId, sequence])
  @@index([createdAt])
  @@map("workflow_execution_logs")
}

