# Non-secret artifact identity. RELEASE_VERSION is also supplied as a Docker build argument.
NODE_ENV=production
APP_ENV=production
DEPLOYMENT_PLATFORM=container
APP_BASE_URL=https://nexus.example.com
SERVICE_NAME=nexus-ai
RELEASE_VERSION=release-or-source-revision
LOG_LEVEL=info

# Secret-manager references; replace at runtime without writing resolved values to this file.
BETTER_AUTH_SECRET=__FROM_SECRET_MANAGER__
MONITORING_TOKEN=__FROM_SECRET_MANAGER__

# Use a pooled TLS endpoint for application traffic and a direct TLS endpoint for migrations.
DATABASE_URL=postgresql://__USER__:__FROM_SECRET_MANAGER__@pool.database.internal/nexus?sslmode=verify-full
DIRECT_URL=postgresql://__USER__:__FROM_SECRET_MANAGER__@primary.database.internal/nexus?sslmode=verify-full

AUTH_TRUSTED_ORIGINS=

# Optional social providers. Configure an entire group or leave the entire group empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

SMTP_HOST=smtp.internal
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=__FROM_SECRET_MANAGER__
SMTP_PASSWORD=__FROM_SECRET_MANAGER__
SMTP_FROM=NEXUS AI <noreply@example.com>

AI_PROVIDER=openai
OPENAI_API_KEY=__FROM_SECRET_MANAGER__
AI_OPENAI_MODEL=gpt-5-mini
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_INPUT_CHARACTERS=128000
AI_MAX_OUTPUT_TOKENS=2048
AI_REQUESTS_PER_MINUTE=12

# Leave S3_ENDPOINT and static credentials empty when the runtime uses AWS workload identity.
OBJECT_STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=nexus-production-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

QUEUE_DRIVER=bullmq
REDIS_URL=rediss://__USER__:__FROM_SECRET_MANAGER__@redis.internal:6379
QUEUE_NAMESPACE=nexus-production
DOCUMENT_WORKER_CONCURRENCY=2

DOCUMENT_MAX_BYTES=26214400
DOCUMENT_MAX_PAGES=500
DOCUMENT_CHUNK_CHARACTERS=1600
DOCUMENT_CHUNK_OVERLAP_CHARACTERS=200
DOCUMENT_SCANNER=clamav
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310

WORKFLOW_MAX_NODES=40
WORKFLOW_MAX_STEPS=100
WORKFLOW_TIMEOUT_MS=600000
WORKFLOW_MAX_INPUT_CHARACTERS=16000
WORKFLOW_MAX_OUTPUT_CHARACTERS=32000
WORKFLOW_CONCURRENT_PER_WORKSPACE=2

# The endpoint receives only sanitized server error envelopes; the token stays server-side.
ERROR_REPORTING_ENDPOINT=https://errors.example.com/v1/events
ERROR_REPORTING_TOKEN=__FROM_SECRET_MANAGER__
ERROR_REPORTING_TIMEOUT_MS=2000
