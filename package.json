{
  "name": "nexus-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The server-first foundation for NEXUS AI.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "prisma generate --config prisma7.config.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:design-system": "playwright test tests/e2e/design-system.spec.ts --workers=1",
    "test:integration": "tsx scripts/with-test-postgres.ts npm run test:integration:database",
    "test:integration:database": "prisma migrate deploy --config prisma7.config.ts && playwright test --workers=1",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:status": "prisma migrate status --config prisma7.config.ts",
    "db:studio": "prisma studio --config prisma7.config.ts",
    "db:test:with": "tsx scripts/with-test-postgres.ts",
    "storage:init": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/initialize-local-storage.ts",
    "outbox:dispatch": "node --conditions=react-server --import tsx scripts/dispatch-outbox.ts",
    "worker:documents": "node --conditions=react-server --import tsx scripts/document-worker.ts",
    "worker:workflows": "node --conditions=react-server --import tsx scripts/workflow-worker.ts",
    "pricing:import": "node --conditions=react-server --import tsx scripts/import-model-price.ts",
    "account-deletions:process": "node --conditions=react-server --import tsx scripts/process-account-deletions.ts",
    "admin:bootstrap": "node --conditions=react-server --import tsx scripts/bootstrap-platform-admin.ts",
    "deploy:validate": "node --import tsx scripts/validate-deployment-environment.ts",
    "deploy:scan-client": "node --import tsx scripts/scan-client-bundle.ts",
    "deploy:smoke": "node --import tsx scripts/smoke-deployment.ts",
    "security:scan-secrets": "node --import tsx scripts/scan-repository-secrets.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.111",
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@better-auth/prisma-adapter": "1.7.18",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ai": "7.0.165",
    "better-auth": "1.7.18",
    "bullmq": "6.7.2",
    "file-type": "22.3.0",
    "highlight.js": "11.12.0",
    "ioredis": "6.0.0",
    "jose": "6.2.15",
    "lucide-react": "1.70.0",
    "mammoth": "1.13.0",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "overrides": {
    "minimatch": "11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "jszip": "3.10.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
